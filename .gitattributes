# Auto-detect text files and normalize line endings on checkout
* text=auto

# Windows-only scripts must always keep CRLF line endings
*.bat text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf
*.iss text eol=crlf

# Source code — normalize to LF in the repo, checked out per-OS default
*.cs text
*.ts text
*.html text
*.scss text
*.css text
*.json text
*.md text

# Binary files — never diff or convert line endings
*.png binary
*.jpg binary
*.ico binary
*.db binary
*.exe binary
